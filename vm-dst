apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: testvmi-dst
spec:
  runStrategy: WaitAsReceiver
  template:
    spec:
      tolerations:  
      - key: node-role.kubernetes.io/control-plane
        operator: Exists
        effect: NoSchedule
      domain:
        memory:
          guest: 2Gi
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: cloudinit
            disk:
              bus: virtio
          interfaces:
          - name: localnet
            bridge: {}
      terminationGracePeriodSeconds: 0
      networks:
      - name: localnet
        multus:
          networkName: localnet1
      volumes:
      - name: containerdisk
        containerDisk:
          image: localhost:5000/kubevirt/fedora-with-test-tooling-container-disk:v1.6.2
          imagePullPolicy: Always
      - name: cloudinit
        cloudInitNoCloud:
          networkData: |
            version: 2
            ethernets:
              eth0:
                addresses:
                - 192.168.1.100/24
                gateway4: 192.168.1.1